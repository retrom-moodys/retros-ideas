# Database (RDS PostgreSQL) — ask your admin for these values
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=webapp
DB_USER=webapp_user
DB_PASSWORD=change-me

# Email transport: smtp | ses | none
# Use "smtp" for locked-down accounts (no IAM role on EC2 required).
EMAIL_TRANSPORT=smtp

# SMTP — works with SES SMTP credentials (admin creates in SES console)
# SES SMTP endpoint reference: email-smtp.<region>.amazonaws.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-ses-smtp-username
SMTP_PASSWORD=your-ses-smtp-password
MAIL_FROM=notifications@yourdomain.com
MAIL_TO=admin@yourdomain.com

# Optional: SES API via boto3 (requires EC2 IAM role + pip install -r requirements-ses-api.txt)
# EMAIL_TRANSPORT=ses
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=notifications@yourdomain.com
# SES_TO_EMAIL=admin@yourdomain.com

# Optional: disable email entirely (form still saves to RDS)
# EMAIL_TRANSPORT=none

# Optional: restrict CORS (comma-separated origins). Leave empty for same-origin only.
CORS_ORIGINS=
