# Local SQLite database (created automatically on first request)
DB_PATH=/opt/ec2-web-app/data/submissions.db

# Email transport: none | smtp | ses
# Default "none" — form works without email. Set "smtp" when admin provides SES SMTP creds.
EMAIL_TRANSPORT=none

# SMTP — optional; works with SES SMTP credentials (admin creates in SES console)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=your-ses-smtp-username
# SMTP_PASSWORD=your-ses-smtp-password
# MAIL_FROM=notifications@yourdomain.com
# MAIL_TO=admin@yourdomain.com

# Optional: SES API via boto3 (requires EC2 IAM role + pip install -r requirements-ses-api.txt)
# EMAIL_TRANSPORT=ses
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=notifications@yourdomain.com
# SES_TO_EMAIL=admin@yourdomain.com

# Optional: restrict CORS (comma-separated origins). Leave empty for same-origin only.
CORS_ORIGINS=
